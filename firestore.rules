rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile. Created on first sign-in by the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.size() <= 3;
    }

    // In-flight interview drafts, mirrored once per completed turn so an
    // interview survives a refresh, a crash, or a change of device.
    // Deleted by the client on submit.
    match /drafts/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['history', 'tapeSent', 'done', 'ready', 'handoffSeen', 'tapped', 'avatar', 'updates', 'updatedAt']);
    }

    // Seat applications: the output of a finished interview.
    // Clients may create their own and read their own; only the engine
    // (Admin SDK, bypasses rules) updates status / seats the agent.
    match /applications/{appId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasAll(['uid', 'status', 'packet', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'status', 'packet', 'email', 'createdAt'])
        && request.resource.data.packet.size() <= 40;
      // no client update/delete: the record is append-only from day one
    }

    // The desk: one private thread per principal per trader. This is the
    // conversation, not the record — it is never published, and the engine
    // never reads it. Doc id is "<uid>_<traderId>".
    match /desks/{deskId} {
      allow read, delete: if request.auth != null
        && deskId.split('_')[0] == request.auth.uid;
      allow create, update: if request.auth != null
        && deskId.split('_')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'trader', 'messages', 'updatedAt'])
        && request.resource.data.messages.size() <= 200;
    }

    // What the principal files: the one thing said at the desk that reaches
    // the trader's work. Created by the principal, never edited or withdrawn;
    // the engine (Admin SDK) stamps its id, ingests it, and writes back the
    // disposition its next session gave it.
    match /guidance/{gid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'filed'
        && request.resource.data.keys().hasOnly(['uid', 'trader', 'text', 'status', 'createdAt'])
        && request.resource.data.trader is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      // no client update/delete: filed is filed
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

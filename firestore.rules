rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile. Created on first sign-in by the client. `credit` is the
    // one thing here that can reach a public page: the name the principal wants
    // printed beside the traders they charter, and whether it is printed at all.
    // Theirs to change or remove at any hour; the engine reads it each tick.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'credit'])
        && request.resource.data.size() <= 4
        && (!('credit' in request.resource.data) || (
              request.resource.data.credit.keys().hasOnly(['name', 'show'])
           && request.resource.data.credit.name is string
           && request.resource.data.credit.name.size() <= 60
           && request.resource.data.credit.show is bool));
    }

    // In-flight interview drafts, mirrored once per completed turn so an
    // interview survives a refresh, a crash, or a change of device.
    // Deleted by the client on submit.
    match /drafts/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['history', 'tapeSent', 'done', 'ready', 'handoffSeen', 'tapped', 'avatar', 'updates', 'updatedAt']);
    }

    // Seat applications: the output of a finished interview.
    // Clients may create their own and read their own; only the engine
    // (Admin SDK, bypasses rules) updates status / seats the agent.
    match /applications/{appId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasAll(['uid', 'status', 'packet', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'status', 'packet', 'email', 'createdAt'])
        && request.resource.data.packet.size() <= 40;
      // no client update/delete: the record is append-only from day one
    }

    // The desk: one private thread per principal per trader. This is the
    // conversation, not the record — it is never published, and the engine
    // never reads it. Doc id is "<uid>_<traderId>".
    match /desks/{deskId} {
      allow read, delete: if request.auth != null
        && deskId.split('_')[0] == request.auth.uid;
      allow create, update: if request.auth != null
        && deskId.split('_')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'trader', 'messages', 'updatedAt'])
        && request.resource.data.messages.size() <= 200;
    }

    // What a trader carries from its desk to its next session: the one thing
    // said in that room that reaches its work. Written when the trader says it
    // is taking something; the engine (Admin SDK) stamps its id, ingests it,
    // and writes back the disposition its session gave it.
    match /guidance/{gid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'filed'
        && request.resource.data.keys().hasOnly(['uid', 'trader', 'text', 'author', 'status', 'createdAt'])
        && request.resource.data.trader is string
        && request.resource.data.author in ['principal', 'trader']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      // A note may be pulled back until a session has read it — before ingestion
      // nothing has entered the record. After that it is answered, not withdrawn.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'filed';
      // never update: what a session was given is what it was given
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
